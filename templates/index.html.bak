// ── 日签 ──
async function loadQuote() {
  try {
    const resp = await fetch('/api/quote');
    const data = await resp.json();
    document.getElementById('quoteText').textContent = '「' + data.text + '」';
    document.getElementById('quoteSource').textContent =
      '—— ' + data.category + (data.concept ? ' · ' + data.concept : '');
  } catch(e) {
    document.getElementById('quoteText').textContent = '「天主是爱，那存留在爱内的，就存留在天主内。」';
  }
}
loadQuote();

// 填充静态头像占位符
document.querySelectorAll('.avatar[data-role]').forEach(el => {
  el.innerHTML = el.dataset.role === 'user' ? USER_SVG : GUIDER_SVG;
});

// ── 聊天逻辑 ──
const messagesEl = document.getElementById('messages');
const inputEl    = document.getElementById('questionInput');
const sendBtn    = document.getElementById('sendBtn');
const typingEl   = document.getElementById('typing');

function addMessage(role, text) {
  const div = document.createElement('div');
  div.className = 'msg ' + role;
  const svg = role === 'user' ? USER_SVG : GUIDER_SVG;
  div.innerHTML =
    '<div class="avatar" data-role="' + role + '">' + svg + '</div>' +
    '<div class="bubble">' + text + '</div>';
  messagesEl.appendChild(div);
  messagesEl.scrollTop = messagesEl.scrollHeight;
}

async function sendQuestion(question) {
  if (!question.trim()) return;

  addMessage('user', question);
  inputEl.value = '';
  sendBtn.disabled = true;
  typingEl.classList.add('active');
  messagesEl.scrollTop = messagesEl.scrollHeight;

  try {
    const resp = await fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ question })
    });
    const data = await resp.json();
    typingEl.classList.remove('active');
    addMessage('bot', data.answer);
  } catch(e) {
    typingEl.classList.remove('active');
    addMessage('bot', '孩子，抱歉……我好像打了个盹。请再试一次好吗？');
  }
  sendBtn.disabled = false;
  inputEl.focus();
}

sendBtn.addEventListener('click', () => sendQuestion(inputEl.value));
inputEl.addEventListener('keydown', e => {
  if (e.key === 'Enter') sendQuestion(inputEl.value);
});

// 推荐问题
document.querySelectorAll('.suggestions button').forEach(btn => {
  btn.addEventListener('click', () => sendQuestion(btn.dataset.q));
});
</script>
</body>
</html>
